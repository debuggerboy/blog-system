package components

import (
	"blog-system/internal/models"
	"blog-system/internal/auth"
	"blog-system/views/layouts"
	"fmt"
)

templ PostCard(post models.Post, user *auth.UserContext) {
	<div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition duration-200" id={ fmt.Sprintf("post-%d", post.ID) }>
		<div class="flex justify-between items-start">
			<div class="flex-1">
				<h3 class="text-xl font-bold text-gray-900">{ post.Title }</h3>
				<div class="mt-2 text-gray-600">{ post.Content }</div>
				<div class="mt-3 text-sm text-gray-500">
					<span>By { post.Author.Username }</span>
					<span class="mx-2">•</span>
					<span>{ post.CreatedAt.Format("Jan 2, 2006 at 3:04 PM") }</span>
					if post.Status == "disabled" {
						<span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Disabled</span>
					} else {
						<span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Published</span>
					}
				</div>
			</div>
			if user != nil && (user.Role == "admin" || user.Role == "supervisor" || user.UserID == post.AuthorID) {
				<div class="flex space-x-2">
					<button hx-get={ fmt.Sprintf("/posts/%d/edit", post.ID) }
							hx-target="#main-content"
							hx-swap="outerHTML"
							class="text-blue-600 hover:text-blue-800 text-sm font-medium cursor-pointer">
						Edit
					</button>
					<button hx-post={ fmt.Sprintf("/posts/%d/toggle", post.ID) }
							hx-target={ fmt.Sprintf("#post-%d", post.ID) }
							hx-swap="outerHTML"
							class="text-yellow-600 hover:text-yellow-800 text-sm font-medium cursor-pointer">
						Toggle
					</button>
					<button hx-delete={ fmt.Sprintf("/posts/%d", post.ID) }
							hx-confirm="Are you sure you want to delete this post?"
							hx-target={ fmt.Sprintf("#post-%d", post.ID) }
							hx-swap="delete"
							class="text-red-600 hover:text-red-800 text-sm font-medium cursor-pointer">
						Delete
					</button>
				</div>
			}
		</div>
	</div>
}

templ PostList(posts []models.Post, user *auth.UserContext) {
	<div class="space-y-4">
		for _, post := range posts {
			@PostCard(post, user)
		}
		if len(posts) == 0 {
			<div class="text-center text-gray-500 py-8">
				<p>No posts found.</p>
			</div>
		}
	</div>
}

// PostForm is for full page loads (when user visits /posts/new or /posts/{id}/edit directly)
templ PostForm(post *models.Post, user *auth.UserContext) {
	@layouts.Base("Edit Post", user) {
		@PostFormOnly(post, user)
	}
}
