package pages

import (
	"blog-system/internal/auth"
	"blog-system/views/layouts"
)

templ Home(user *auth.UserContext) {
	@layouts.Base("Home", user) {
		<div class="text-center py-12">
			<h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to Blog System</h1>
			<p class="text-xl text-gray-600 mb-8">Share your thoughts and ideas with the world</p>
			if user == nil {
				<div class="space-x-4">
					<a href="/login" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-200">
						Login
					</a>
					<a href="/register" class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-300 transition duration-200">
						Register
					</a>
				</div>
			} else {
				<div class="space-x-4">
					<a href="/posts/new" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-200">
						Create New Post
					</a>
					<a href="/posts" class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-300 transition duration-200">
						View All Posts
					</a>
				</div>
			}
		</div>
	}
}
