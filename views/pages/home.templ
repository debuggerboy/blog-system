package pages

import (
	"blog-system/internal/models"
	"blog-system/internal/auth"
	"blog-system/views/layouts"
	"fmt"
)

templ Home(user *auth.UserContext, latestPosts []models.Post) {
	@layouts.Base("Home", user) {
		<div class="flex flex-col lg:flex-row gap-8">
			<!-- Main Content -->
			<div class="flex-1">
				<!-- Welcome Section -->
				<div class="bg-white rounded-lg shadow-md p-8 mb-8">
					<h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to Blog System</h1>
					<p class="text-xl text-gray-600 mb-6">Share your thoughts and ideas with the world</p>
					
					if user == nil {
						<div class="space-x-4">
							<a href="/login" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-200">
								Login
							</a>
							<a href="/register" class="inline-block bg-gray-200 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-300 transition duration-200">
								Register
							</a>
						</div>
					} else {
						<div class="space-x-4">
							<a href="/posts/new" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-200">
								Create New Post
							</a>
							<a href="/posts" class="inline-block bg-gray-200 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-300 transition duration-200">
								View All Posts
							</a>
						</div>
					}
				</div>

				<!-- Latest Posts Section -->
				<div class="bg-white rounded-lg shadow-md p-8">
					<h2 class="text-2xl font-bold text-gray-900 mb-6">Latest Posts</h2>
					
					if len(latestPosts) == 0 {
						<div class="text-gray-500 text-center py-8">
							<p>No posts available yet.</p>
							if user != nil {
								<a href="/posts/new" class="text-blue-600 hover:underline">Create the first post!</a>
							}
						</div>
					} else {
						<div class="space-y-6">
							for _, post := range latestPosts {
								<div class="border-b border-gray-200 pb-6 last:border-0 last:pb-0">
									<div class="flex items-start justify-between">
										<div>
											<h3 class="text-xl font-semibold text-gray-900">
												<a href="#" class="hover:text-blue-600 transition duration-200">
													{ post.Title }
												</a>
											</h3>
											<div class="mt-2 text-gray-600 line-clamp-3">
												{ post.Content }
											</div>
											<div class="mt-3 text-sm text-gray-500">
												<span>By { post.Author.Username }</span>
												<span class="mx-2">•</span>
												<span>{ post.CreatedAt.Format("Jan 2, 2006") }</span>
												if post.Pinned {
													<span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
														📌 Pinned
													</span>
												}
											</div>
										</div>
										if user != nil && (user.Role == "admin" || user.Role == "supervisor" || user.UserID == post.AuthorID) {
											<div class="flex space-x-2 text-sm">
												<a href={ fmt.Sprintf("/posts/%d/edit", post.ID) } class="text-blue-600 hover:text-blue-800">Edit</a>
											</div>
										}
									</div>
								</div>
							}
						</div>
						
						<div class="mt-6 text-center">
							<a href="/posts" class="text-blue-600 hover:text-blue-800 font-medium">
								View All Posts →
							</a>
						</div>
					}
				</div>
			</div>

			<!-- Sidebar -->
			<div class="lg:w-80 flex-shrink-0">
				<div class="bg-white rounded-lg shadow-md p-6">
					<h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Links</h3>
					<ul class="space-y-2">
						<li>
							<a href="/posts" class="text-blue-600 hover:text-blue-800">📝 All Posts</a>
						</li>
						if user != nil {
							<li>
								<a href="/posts/new" class="text-blue-600 hover:text-blue-800">✏️ Create New Post</a>
							</li>
							if user.Role == "admin" || user.Role == "supervisor" {
								<li>
									<a href="/admin/users" class="text-blue-600 hover:text-blue-800">👥 Manage Users</a>
								</li>
							}
						} else {
							<li>
								<a href="/login" class="text-blue-600 hover:text-blue-800">🔑 Login</a>
							</li>
							<li>
								<a href="/register" class="text-blue-600 hover:text-blue-800">📝 Register</a>
							</li>
						}
					</ul>
					
					<hr class="my-4"/>
					
					<div class="text-sm text-gray-500">
						<p>Welcome to the blog system!</p>
						<p class="mt-2">Share your thoughts with the community.</p>
					</div>
				</div>
			</div>
		</div>
	}
}
